APP_NAME=Recepty
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=sk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sk_SK

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Recepty – domácnosť a médiá
RECIPES_DEFAULT_TIMEZONE=Europe/Bratislava
MEDIA_DISK=local
QUEUE_CONVERSIONS_BY_DEFAULT=false

# AI (Laravel AI SDK). Bez kľúča sú AI funkcie označené ako nenakonfigurované, všetko ostatné funguje.
OPENAI_API_KEY=
RECIPES_AI_TEXT_PROVIDER=openai
RECIPES_AI_IMAGE_PROVIDER=openai
RECIPES_AI_TEXT_MODEL=
RECIPES_AI_IMAGE_MODEL=
RECIPES_AI_DAILY_TEXT_LIMIT=30
RECIPES_AI_DAILY_IMAGE_LIMIT=10
RECIPES_AI_MAX_CONCURRENT=2
RECIPES_AI_TIMEOUT=120
RECIPES_AI_TEXT_REASONING_EFFORT=low
RECIPES_AI_IMAGE_QUALITY=medium
RECIPES_AI_MONTHLY_BUDGET_USD=
RECIPES_AI_ENABLED=true
# Ledger AI použití: false = len denné limity (bez grantov), true = každá úloha rezervuje jedno použitie.
RECIPES_USAGE_ENFORCE=true
RECIPES_USAGE_TRIAL_TEXT=3
RECIPES_USAGE_TRIAL_IMAGES=1

# Stripe / Cashier (testovacie a živé kľúče sú oddelené; bez cien je checkout danej ponuky zablokovaný)
# Platený checkout je vypnutý, kým prepínač nezapneš samostatným nasadením (etapa 7, `php artisan app:launch-check`).
RECIPES_CHECKOUT_ENABLED=true
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=sk
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_IMAGES_20_STANDARD=
STRIPE_PRICE_TEXT_100=
RECIPES_BILLING_TIMEZONE=Europe/Bratislava
RECIPES_BILLING_GRACE_DAYS=3
# Optional USD→EUR rate for the admin "contribution after variable costs" estimate (AI costs are measured in USD).
RECIPES_BILLING_USD_EUR_RATE=
RECIPES_CONSENT_LIFETIME_DAYS=180

# Administrácia (/admin). Rolu udeľuje iba `php artisan app:grant-platform-admin <email>`.
ADMIN_EMAIL=support@moje-recepty.sk
ADMIN_NAME="Podpora Moje recepty"
# Iba pre seeder mimo produkcie (predvolene "password"); v produkcii zadaj heslo príkazu cez --password a potom ho zmeň.
ADMIN_INITIAL_PASSWORD=
ADMIN_REQUIRE_TWO_FACTOR=true
